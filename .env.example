# Copy to .jac/onboarding.env, edit privately, and restart the server.
# Bash syntax. Never commit actual credentials. No sender is enabled by default.
export MLOCAL_SMTP_HOST=''
export MLOCAL_SMTP_PORT='465'
export MLOCAL_SMTP_USERNAME=''
export MLOCAL_SMTP_PASSWORD=''
export MLOCAL_SMTP_FROM=''

# Optional: enables Jac by llm() extraction. Leave empty for metadata-only import.
export MLOCAL_IMPORT_MODEL=''
# Set the credential required by that provider in this private file as well.
# export OPENAI_API_KEY='...'
